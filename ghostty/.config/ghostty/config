# Configuración de Ghostty
# Generada por la IA

# Tema para que matchee tu estética de VS Code
theme = Night Owl

# Fuente principal (Harfbuzz/Ligatures soportadas por defecto)
font-family = "Fira Code"
font-size = 14

# Estética de ventana
window-padding-x = 10
window-padding-y = 10
background-opacity = 0.95
window-decoration = false

# Otros extras piolas de Ghostty
cursor-style = bar
shell-integration = zsh

# Keybinds de navegación de splits (A pedido de la casa: Ctrl + Flechas)
keybind = ctrl+left=goto_split:left
keybind = ctrl+right=goto_split:right
keybind = ctrl+up=goto_split:up
keybind = ctrl+down=goto_split:down
