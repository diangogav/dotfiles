[user]
    name = DiangoGav
    email = diango.code@gmail.com

[core]
    editor = code --wait
    autocrlf = input

[init]
    defaultBranch = main

[pull]
    rebase = false

[alias]
    s = status
    c = commit
    co = checkout
    b = branch
    df = diff
    lg = log --graph --oneline --decorate --all
