// Zellij Configuration
// Managed by dotfiles

// General Settings
default_layout "compact" // Uses a thinner status bar to save space
mouse_mode true
copy_on_select true

// Theme
// Zellij inherits terminal colors by default. You can set a specific one like "dracula", "nord", etc.
theme "default"

// Keybinds (Default are very good, but we can customize here)
keybinds {
    normal {
        // You can add custom keybinds here if the defaults don't suit you
    }
}
